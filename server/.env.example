# ============================================================================
#  PIE — Potential Intelligence Engine
#  Environment configuration.  Edit this file, then restart:  npm start
# ============================================================================
#
#  HOW IT WORKS
#    Paste a value after the "=" with NO quotes and NO spaces around it.
#    Leave a line blank to keep that feature off — PIE runs fine either way.
#    Lines starting with # are ignored.
#
#  SECURITY — read this once
#    • This file is read by the SERVER ONLY. Nothing here ever reaches the browser.
#    • It is already in .gitignore. Never commit it, never paste it into chat,
#      never put any of these values in the web/ folder.
#    • If a key is ever exposed, revoke it and issue a new one. Rotating is cheap;
#      a leaked key is not.
#
#  WHAT STILL WORKS WITH EVERYTHING BLANK
#    All of it. Accounts, capability scores, matching, gaps, learning pathways,
#    bias signals and the audit trail are computed and stored locally. The AI layer
#    only writes the prose. Your demo is identical with the network unplugged.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  1. AI PROVIDER  —  optional
#     PIE tries SAP Generative AI Hub first, then OpenAI, then offline templates.
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: SAP Generative AI Hub (preferred for the Hackfest) ---
# Requires a real SAP AI Core deployment exposing an OpenAI-compatible
# /chat/completions endpoint. Get these from SAP BTP → AI Core → Deployments.
# Nothing is defaulted or guessed: with these blank, the adapter reports OFFLINE.
SAP_AI_CORE_DEPLOYMENT_URL=
SAP_AI_CORE_TOKEN=
SAP_AI_RESOURCE_GROUP=default
SAP_AI_CORE_API_VERSION=2023-05-15

# --- Option B: OpenAI (or any OpenAI-compatible endpoint) ---
# Paste your NEW key below. It should begin with "sk-".
# ⚠️  If you previously shared a key in a chat or a screenshot, revoke it first at
#     https://platform.openai.com/api-keys and generate a fresh one.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# How long PIE waits for the AI layer before falling back to templates (ms).
# Keep this short on stage — a slow answer is worse than a template one.
AI_TIMEOUT_MS=12000


# ─────────────────────────────────────────────────────────────────────────────
#  1b. ALTERNATIVE AI PROVIDERS  —  optional
#
#     PIE uses the FIRST provider configured, in this order:
#       SAP Generative AI Hub → OpenAI → Gemini → Ollama → offline templates
#
#     All three of OpenAI, Gemini and Ollama speak the same API shape, so
#     switching is a matter of which variables are filled in. No score changes.
# ─────────────────────────────────────────────────────────────────────────────

# --- Google Gemini ---
# Free tier: no credit card, generous daily limit. Get a key at
# https://aistudio.google.com/apikey
# ⚠️  Google may use FREE-TIER prompts to improve its models. For real candidate
#     evidence use a paid tier, or a local model below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local model via Ollama ---
# For institutions that cannot send candidate data to any third party.
# Install from ollama.com, then:  ollama pull llama3.1  &&  ollama serve
# Leave OLLAMA_BASE_URL blank to keep this off — PIE never goes looking for it.
# ⚠️  A small local model is slower and weaker at structured output. PIE validates
#     every response and falls back to templates, so a bad answer costs nothing
#     but the narration. Not recommended for a live stage demo.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=90000

# ─────────────────────────────────────────────────────────────────────────────
#  2. ACCOUNTS & SESSIONS
#     Passwords are hashed with bcrypt. The plain password is never written to
#     disk, never logged and never returned by any endpoint.
# ─────────────────────────────────────────────────────────────────────────────

# The single administrator ("Trust & Integrity") account. It cannot be created
# from the sign-up form — it is provisioned server-side on first boot.
#   • Set a password here to choose your own.
#   • Leave it blank and PIE generates one and prints it to the SERVER CONSOLE
#     once, on first boot only. It is never shown in the browser.
# To change it later: set the value, delete server/data/pie.json, restart.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pie.local
ADMIN_PASSWORD=

# How long a sign-in lasts before the session expires (hours).
SESSION_TTL_HOURS=12

# Encrypts GitHub access tokens at rest (AES-256-GCM). Must be 32+ characters.
# Leave blank and PIE generates a key into server/data/.token-key (chmod 600).
# If you change or lose this value, stored GitHub connections cannot be decrypted
# and candidates are simply asked to reconnect — no data is lost.
TOKEN_ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────────────────────────
#  3. GITHUB AUTHORIZATION  —  optional
#
#     Blank  → "Connect GitHub" offers clearly-labelled DEMO repositories and the
#              UI says so. Nothing is presented as if it came from the real API.
#     Set    → the real OAuth flow: GitHub's own consent screen, the candidate
#              approves, PIE reads public profile + repository metadata.
#
#     CREATE THE APP: github.com → Settings → Developer settings →
#     OAuth Apps → New OAuth App
#       Application name      PIE — Potential Intelligence Engine
#       Homepage URL          http://localhost:5174
#       Authorization callback URL   http://localhost:5174/api/github/callback
#                             ^ must match GITHUB_CALLBACK_URL below exactly
#
#     PIE requests the "read:user" scope only. It cannot push, modify, delete or
#     read private repositories, and it never asks for a password.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5174/api/github/callback

# Optional server-side token for anonymous public-repo lookups (no OAuth).
# Leave blank unless you know you need it — an invalid value here makes PIE fall
# back to demo fixtures and show a notice.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com


# ─────────────────────────────────────────────────────────────────────────────
#  4. SUPABASE  —  optional (PostgreSQL + Row Level Security)
#
#     Blank  → PIE persists to server/data/pie.json. Works offline. Default.
#     Set    → PIE reports the live connection state and can mirror data into
#              your project.
#
#     TO ACTIVATE
#       1. supabase.com → your project → resume it if it is paused
#       2. SQL Editor → paste server/supabase/schema.sql → Run
#       3. Settings → API → copy the Project URL and the service_role key below
#       4. Restart. Sign in as the admin → System readiness → Verify connection.
#
#     ⚠️  SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It belongs on the
#         server only. Never put it in web/, never expose it to the browser.
#         The browser, if you wire it up, uses the anon key and is governed by
#         the RLS policies in schema.sql.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_MS=8000

# Mirror new writes into Supabase (1 = on). The JSON store stays the system of
# record either way — nothing reads back from Supabase yet.
#   1. Run schema.sql, then grants.sql, then 002_mirror.sql in the SQL editor
#   2. Set this to 1 and restart
#   3. node tools/supabase-sync.mjs            (dry run — shows what would go)
#      node tools/supabase-sync.mjs --push     (actually copy the rows across)
#      node tools/supabase-sync.mjs --verify   (compare both sides)
# A Supabase outage cannot affect the app: pushes are write-behind and failures
# are reported, never thrown.
SUPABASE_MIRROR=
SUPABASE_MIRROR_FLUSH_MS=1500
SUPABASE_MIRROR_BATCH=200


# ─────────────────────────────────────────────────────────────────────────────
#  5. EMAIL (SMTP)  —  optional, for "Forgot password"
#
#     Blank  → the reset flow still works. PIE issues a valid link and prints it
#              to the SERVER CONSOLE instead of emailing it. Good for testing.
#     Set    → the link is emailed to the account holder.
#
#     GMAIL: you cannot use your normal password. Turn on 2-Step Verification,
#     then create an App Password (Google Account → Security → App passwords)
#     and paste THAT 16-character value into SMTP_PASS.
#       SMTP_HOST=smtp.gmail.com
#       SMTP_PORT=587
#       SMTP_USER=you@gmail.com
#       SMTP_PASS=<16-char app password, no spaces>
#       SMTP_FROM=PIE <you@gmail.com>
#
#     ⚠️  An app password is a real credential. It lives here and nowhere else —
#         never in web/, never in a commit, never in a screenshot.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# How long a reset link stays valid (minutes). It is single-use regardless.
RESET_TTL_MINUTES=45

# The base URL that reset links point at. Change it if you serve on another host.
APP_BASE_URL=http://localhost:5174


# ─────────────────────────────────────────────────────────────────────────────
#  6. SAP ENTERPRISE TIER  —  leave blank
#     These are PROPOSED / FUTURE integrations. Leaving them empty is the honest
#     default: the adapters report ADAPTER_READY or FUTURE_INTEGRATION on the SAP
#     Integration Readiness screen, and PIE claims nothing more than that.
#     Only fill these in if you actually provision the service.
# ─────────────────────────────────────────────────────────────────────────────

# SAP BTP / CAP — enterprise service layer
SAP_BTP_CAP_URL=
SAP_BTP_TOKEN=

# SAP HANA Cloud — enterprise system of record
SAP_HANA_HOST=
SAP_HANA_USER=
SAP_HANA_PASSWORD=

# SAP SuccessFactors / Talent Intelligence Hub — talent workflow
SF_API_URL=
SF_COMPANY_ID=
SF_TOKEN=

# SAP Analytics Cloud / Business Data Cloud — cohort analytics
SAC_TENANT_URL=
SAC_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
#  7. SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Port the API and the built UI are served on.
PORT=5174

# Where the local JSON store lives. Delete that file, or press "Reset demo"
# in the app, to wipe the demo world and reseed. "Reset demo" never touches
# real accounts.
PIE_DATA_DIR=./data

# Set to production when deploying behind HTTPS — session cookies become Secure.
NODE_ENV=development
