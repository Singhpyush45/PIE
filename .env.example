# ============================================================================
#  PIE — Potential Intelligence Engine
#  Environment configuration.  Edit this file, then restart:  npm start
# ============================================================================
#
#  HOW IT WORKS
#    Paste a value after the "=" with NO quotes and NO spaces around it.
#    Leave a line blank to keep that feature off — PIE runs fine either way.
#    Lines starting with # are ignored.
#
#  SECURITY — read this once
#    • This file is read by the SERVER ONLY. Nothing here ever reaches the browser.
#    • It is already in .gitignore. Never commit it, never paste it into chat,
#      never put any of these values in the web/ folder.
#    • If a key is ever exposed, revoke it and issue a new one. Rotating is cheap;
#      a leaked key is not.
#
#  WHAT STILL WORKS WITH EVERYTHING BLANK
#    All of it. Capability scores, matching, gaps, learning pathways, bias signals
#    and the audit trail are computed deterministically on the server. The AI layer
#    only writes the prose. Your demo is identical with the network unplugged.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  1. AI PROVIDER  —  optional
#     PIE tries SAP Generative AI Hub first, then OpenAI, then offline templates.
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: SAP Generative AI Hub (preferred for the Hackfest) ---
# Requires a real SAP AI Core deployment exposing an OpenAI-compatible
# /chat/completions endpoint. Get these from SAP BTP → AI Core → Deployments.
# Nothing is defaulted or guessed: with these blank, the adapter reports OFFLINE.
SAP_AI_CORE_DEPLOYMENT_URL=
SAP_AI_CORE_TOKEN=
SAP_AI_RESOURCE_GROUP=default
SAP_AI_CORE_API_VERSION=2023-05-15

# --- Option B: OpenAI (or any OpenAI-compatible endpoint) ---
# Paste your NEW key below. It should begin with "sk-".
# ⚠️  If you previously shared a key in a chat or a screenshot, revoke it first at
#     https://platform.openai.com/api-keys and generate a fresh one.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# How long PIE waits for the AI layer before falling back to templates (ms).
# Keep this short on stage — a slow answer is worse than a template one.
AI_TIMEOUT_MS=12000


# ─────────────────────────────────────────────────────────────────────────────
#  2. GITHUB  —  optional
#     Blank  → repository import returns clearly-labelled DEMO data.
#     Set    → reads public repository metadata from the GitHub REST API.
#     Invalid→ PIE falls back to demo data and says so in the UI (never crashes).
#
#     Create at github.com → Settings → Developer settings → Personal access
#     tokens. Read-only, public repositories. Nothing more is needed.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com


# ─────────────────────────────────────────────────────────────────────────────
#  3. SAP ENTERPRISE TIER  —  leave blank
#     These are PROPOSED / FUTURE integrations. Leaving them empty is the honest
#     default: the adapters report ADAPTER_READY or FUTURE_INTEGRATION on the SAP
#     Integration Readiness screen, and PIE claims nothing more than that.
#     Only fill these in if you actually provision the service.
# ─────────────────────────────────────────────────────────────────────────────

# SAP BTP / CAP — enterprise service layer
SAP_BTP_CAP_URL=
SAP_BTP_TOKEN=

# SAP HANA Cloud — enterprise system of record
SAP_HANA_HOST=
SAP_HANA_USER=
SAP_HANA_PASSWORD=

# SAP SuccessFactors / Talent Intelligence Hub — talent workflow
SF_API_URL=
SF_COMPANY_ID=
SF_TOKEN=

# SAP Analytics Cloud / Business Data Cloud — cohort analytics
SAC_TENANT_URL=
SAC_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
#  4. SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Port the API and the built UI are served on.
PORT=5174

# Where the demo's JSON store lives. Delete that file, or press "Reset demo"
# in the app, to wipe all accounts, evidence and decisions and reseed.
PIE_DATA_DIR=./data
